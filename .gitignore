# ── Node / pnpm ──────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
pnpm-debug.log*
.pnpm-store/

# ── PokeRogue source clone / build output ───────────────────────────────────
# CI always clones pokerogue-src fresh; nothing under it should ever be committed.
pokerogue-src/
dist/
build/
out/

# ── Electron ─────────────────────────────────────────────────────────────────
*.dmg
*.exe
*.AppImage
release/

# ── App icons — generated per-run by scripts/generate-icons.sh from
#    docs/appIcon-master.png (+ optional docs/icon-overrides/*.png).
#    Never commit these; commit the master/overrides instead.
docs/appIcon.png
docs/appIcon-dev.png
docs/appIcon-adaptive.png
docs/appIcon.ico
docs/appIcon.icns

# ── Capacitor / Android ─────────────────────────────────────────────────────
android/
!patches/android/
*.apk
*.aab
*.keystore
# ...except the per-fork Android debug keystore, auto-generated and
# committed by build-android.yml on its first run — see README.
!configs/android/debug.keystore
*.jks

# ── Capacitor / iOS ──────────────────────────────────────────────────────────
ios/
*.ipa
*.mobileprovision
*.p12
*.p8
*.cer

# ── Local secrets / env ──────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key

# ── Editor / OS cruft ────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp
Thumbs.db
